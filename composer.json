{
    "name": "codeartmk/opensearch-laravel",
    "description": "This package integrates the Opensearch client to work seamlessly with your Laravel Eloquent Model.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "opensearch-project/opensearch-php": "^2.7",
        "guzzlehttp/guzzle": "^7.8|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Codeart\\OpensearchLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codeart\\OpensearchLaravel\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codeart\\OpensearchLaravel\\OpenSearchServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Ivan Janev",
            "email": "ivan@codeart.mk"
        },
        {
            "name": "Codeart",
            "email": "contact@codeart.mk"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
